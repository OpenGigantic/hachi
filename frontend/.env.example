# Server-only: TanStack Start server functions call the Python gateway using this base URL.
TOKOBOROS_GATEWAY_BASE_URL=http://127.0.0.1:8787

# Optional server-only auth header for future secured gateway deployments.
# Example: Bearer my-token
TOKOBOROS_GATEWAY_AUTH_HEADER=

# Poll cadence used by server handlers/components for events/session refresh loops.
TOKOBOROS_GATEWAY_POLL_MS=1500
