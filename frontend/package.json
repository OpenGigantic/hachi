{
  "name": "hachi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../openapi/hachi-openapi.json -o src/lib/data/schema.d.ts",
    "check:api": "openapi-typescript ../openapi/hachi-openapi.json -o src/lib/data/schema.d.ts && git diff --exit-code -- src/lib/data/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tanstack/router-devtools": "^1.114.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.114.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}
