# Copy this file to .env inside your isolated QA runtime directory.
# These values are intentionally fake and safe for fault-injection testing.

TOKOBOROS_GATEWAY_BASE_URL=http://127.0.0.1:8787
TOKOBOROS_GATEWAY_API_TOKEN=qa-phase-token
TOKOBOROS_GATEWAY_AUTH_HEADER=Bearer qa-phase-token
TOKOBOROS_GATEWAY_MAX_SESSIONS=5
TOKOBOROS_GATEWAY_MAX_PROMPT_CHARS=1024
TOKOBOROS_GATEWAY_POLL_MS=300

# Keep outbound policy explicit in QA runs.
TOKOBOROS_REST_ALLOWLIST=api.example.test
TOKOBOROS_REST_ALLOW_PRIVATE=false

# Secret backend fallback test fixture.
TOKOBOROS_SECRET_PASSPHRASE=qa-not-a-real-secret

# Provider placeholders (do not use production keys here).
ANTHROPIC_API_KEY=qa-placeholder
OPENAI_API_KEY=qa-placeholder
OPENAI_BASE_URL=https://api.example.test/v1
